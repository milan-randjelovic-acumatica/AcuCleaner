<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:converters="clr-namespace:AcuCleanerVSExtension.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="AcuCleanerVSExtension.AcuCleanerToolWindowControl"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="White"
             Loaded="UserControl_Loaded" d:DesignHeight="670.472">
	<UserControl.Resources>
		<converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
		<converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
		<SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="Black"/>
		<SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="White"/>
		<SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="White"/>
		<SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>

		<Style TargetType="{x:Type Menu}">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Menu}">
						<Border Background="{TemplateBinding Background}"
								BorderBrush="#FF808080"
								BorderThickness="0,0,0,1"
								Padding="2,1">
							<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style TargetType="{x:Type MenuItem}">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type MenuItem}">
						<Grid SnapsToDevicePixels="True">
							<Border x:Name="ItemBorder"
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="1">
								<Grid Margin="2,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<ContentPresenter x:Name="IconHost"
												  ContentSource="Icon"
												  Margin="4,2,6,2"
												  VerticalAlignment="Center"/>
									<ContentPresenter x:Name="HeaderHost"
												  Grid.Column="1"
												  ContentSource="Header"
												  Margin="{TemplateBinding Padding}"
												  RecognizesAccessKey="True"
												  VerticalAlignment="Center"/>
									<TextBlock x:Name="GestureText"
											   Grid.Column="2"
											   Margin="20,0,12,0"
											   VerticalAlignment="Center"
											   Foreground="{TemplateBinding Foreground}"
											   Text="{TemplateBinding InputGestureText}"/>
									<Path x:Name="SubmenuArrow"
										  Grid.Column="3"
										  Margin="8,0,4,0"
										  VerticalAlignment="Center"
										  Fill="{TemplateBinding Foreground}"
										  Data="M 0 0 L 4 3.5 L 0 7 Z"
										  Visibility="Collapsed"/>
								</Grid>
							</Border>
							<Popup x:Name="PART_Popup"
								   AllowsTransparency="True"
								   Focusable="False"
								   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
								   Placement="Bottom"
								   PopupAnimation="Fade">
								<Border Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
										BorderBrush="#FF808080"
										BorderThickness="1"
										Padding="1">
									<StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
								</Border>
							</Popup>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="Role" Value="TopLevelHeader">
								<Setter Property="Padding" Value="6,2"/>
								<Setter TargetName="ItemBorder" Property="BorderThickness" Value="0"/>
								<Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/>
							</Trigger>
							<Trigger Property="Role" Value="SubmenuHeader">
								<Setter Property="Padding" Value="8,4"/>
								<Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
								<Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
							</Trigger>
							<Trigger Property="Role" Value="SubmenuItem">
								<Setter Property="Padding" Value="8,4"/>
							</Trigger>
							<Trigger Property="IsHighlighted" Value="True">
								<Setter TargetName="ItemBorder" Property="Background" Value="#FF2D2D30"/>
								<Setter Property="Foreground" Value="White"/>
							</Trigger>
							<Trigger Property="IsSubmenuOpen" Value="True">
								<Setter TargetName="ItemBorder" Property="Background" Value="#FF2D2D30"/>
								<Setter Property="Foreground" Value="White"/>
							</Trigger>
							<Trigger Property="Icon" Value="{x:Null}">
								<Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="#FF7A7A7A"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style TargetType="{x:Type GroupBox}">
			<Setter Property="BorderThickness" Value="0.5"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#FF808080"/>
		</Style>
		<Style TargetType="{x:Type CheckBox}">
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style TargetType="{x:Type Button}">
			<Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#FF808080"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
					<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
				</Trigger>
				<Trigger Property="IsPressed" Value="True">
					<Setter Property="Background" Value="#FF3A3D41"/>
					<Setter Property="Foreground" Value="White"/>
				</Trigger>
			</Style.Triggers>
		</Style>
		<Style TargetType="{x:Type DataGridColumnHeader}">
			<Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="White"/>
		</Style>
	</UserControl.Resources>
	<DockPanel>

		<!-- Menu bar (File / Tools) -->
		<Menu DockPanel.Dock="Top"
			  Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
			  Foreground="White">
			<MenuItem Header="File">
				<MenuItem Header="Refresh"       InputGestureText="F5"      Click="RefreshMenuItem_Click"/>
				<MenuItem Header="Exit"          InputGestureText="Alt+F4"  Click="ExitMenuItem_Click"/>
			</MenuItem>
			<MenuItem Header="Tools">
				<MenuItem Header="Reset Password"          InputGestureText="Ctrl+R" Click="ResetPasswordMenuItem_Click"/>
				<MenuItem Header="Enable Modern UI Switch" InputGestureText="Ctrl+M" Click="EnableModernUISwitchMenuItem_Click"/>
				<MenuItem Header="Extend Session Timeout"  InputGestureText="Ctrl+T" Click="ExtendSessionTimeoutMenuItem_Click"/>
				<Separator/>
				<MenuItem Header="Apply All Patches"       InputGestureText="Ctrl+P" Click="ApplyAllPatchesMenuItem_Click"/>
			</MenuItem>
		</Menu>

		<!--Status bar -->
		<StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}">
			<StatusBarItem>
				<TextBlock x:Name="statusLabel" Text="Ready" Foreground="White"/>
			</StatusBarItem>
			<StatusBarItem HorizontalAlignment="Right">
				<ProgressBar x:Name="progressBar"
                             Width="100" Height="14"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>
			</StatusBarItem>
		</StatusBar>

		<!-- Main content -->
		<Grid Margin="4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="230"/>
			</Grid.ColumnDefinitions>

			<!-- Instances GroupBox + DataGrid  -->
			<GroupBox Grid.Column="0" Header="Instances" Margin="0,0,4,0">
				<DataGrid x:Name="dataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                          Foreground="White"
                          BorderBrush="#FF808080"
                          RowBackground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                          AlternatingRowBackground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                          HorizontalGridLinesBrush="#FF303030"
                          VerticalGridLinesBrush="#FF303030"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
					<DataGrid.RowStyle>
						<Style TargetType="{x:Type DataGridRow}">
							<Style.Triggers>
								<DataTrigger Binding="{Binding Active}" Value="False">
									<Setter Property="Foreground" Value="Orange"/>
									<Setter Property="ToolTip"    Value="App doesn`t exist in IIS"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</DataGrid.RowStyle>
					<DataGrid.Columns>
						<DataGridTextColumn Header="#"                  Binding="{Binding Id}"               Width="45"  IsReadOnly="True"/>
						<DataGridTextColumn Header="Instance"           Binding="{Binding InstanceName}"     Width="150" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Status" Width="70" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"/>
                                        <Image Grid.Column="1" Source="/AcuCleanerVSExtension;component/Images/warning.png" Width="16" Height="16" Margin="2,0,4,0" VerticalAlignment="Center"
											   Visibility="{Binding Active, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Installed On"       Binding="{Binding InstalledOn, StringFormat=\{0:d\}}" Width="90" IsReadOnly="True"/>
						<DataGridTemplateColumn Header="Path" Width="160" SortMemberPath="Path">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<TextBlock Text="{Binding Path}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"/>
										<Image Grid.Column="1" Source="/AcuCleanerVSExtension;component/Images/folder.png" Width="16" Height="16" Margin="2,0,4,0" VerticalAlignment="Center"
											   Visibility="{Binding Path, Converter={StaticResource StringToVisibilityConverter}}"/>
									</Grid>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Header="AspTempFiles Path" Width="*" SortMemberPath="AspTempFilesPath">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<TextBlock Text="{Binding AspTempFilesPath}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"/>
										<Image Grid.Column="1" Source="/AcuCleanerVSExtension;component/Images/folder.png" Width="16" Height="16" Margin="2,0,4,0" VerticalAlignment="Center"
											   Visibility="{Binding AspTempFilesPath, Converter={StaticResource StringToVisibilityConverter}}"/>
									</Grid>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Header="Customization Path" Width="*" SortMemberPath="CustomizationPath">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<TextBlock Text="{Binding CustomizationPath}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"/>
										<Image Grid.Column="1" Source="/AcuCleanerVSExtension;component/Images/folder.png" Width="16" Height="16" Margin="2,0,4,0" VerticalAlignment="Center"
											   Visibility="{Binding CustomizationPath, Converter={StaticResource StringToVisibilityConverter}}"/>
									</Grid>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Header="Backup Path" Width="*" SortMemberPath="BackupPath">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<TextBlock Text="{Binding BackupPath}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"/>
										<Image Grid.Column="1" Source="/AcuCleanerVSExtension;component/Images/folder.png" Width="16" Height="16" Margin="2,0,4,0" VerticalAlignment="Center"
											   Visibility="{Binding BackupPath, Converter={StaticResource StringToVisibilityConverter}}"/>
									</Grid>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Header="Snapshot Path" Width="*" SortMemberPath="SnapshotPath">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<TextBlock Text="{Binding SnapshotPath}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"/>
										<Image Grid.Column="1" Source="/AcuCleanerVSExtension;component/Images/folder.png" Width="16" Height="16" Margin="2,0,4,0" VerticalAlignment="Center"
											   Visibility="{Binding SnapshotPath, Converter={StaticResource StringToVisibilityConverter}}"/>
									</Grid>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Database" Width="130" SortMemberPath="Database">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Database}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"/>
                                        <Image Grid.Column="1" Source="/AcuCleanerVSExtension;component/Images/database.png" Width="16" Height="16" Margin="2,0,4,0" VerticalAlignment="Center"
											   Visibility="{Binding Database, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Registry Path" Width="*" SortMemberPath="RegistryPath">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<TextBlock Text="{Binding RegistryPath}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"/>
										<Image Grid.Column="1" Source="/AcuCleanerVSExtension;component/Images/registry.png" Width="16" Height="16" Margin="2,0,4,0" VerticalAlignment="Center"
											   Visibility="{Binding RegistryPath, Converter={StaticResource StringToVisibilityConverter}}"/>
									</Grid>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</GroupBox>

			<!-- Right panel: Filter + Cleanup -->
			<Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- Filter GroupBox -->
				<GroupBox x:Name="groupBoxFilter" Grid.Row="0" Header="Filter" HorizontalAlignment="Stretch" VerticalAlignment="Top">
					<StackPanel Margin="4,2,4,4">
						<TextBlock Text="Older than:" Margin="0,4,0,2"/>
						<DatePicker x:Name="datePicker"
										Margin="0,0,0,6"
										SelectedDateChanged="DatePicker_SelectedDateChanged"/>
						<CheckBox x:Name="checkBoxActive"
									  Content="Active"
									  IsChecked="True" Margin="0,2"
									  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
						<CheckBox x:Name="checkBoxJunk"
									  Content="Inactive"
									  IsChecked="True" Margin="0,2"
									  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
						<CheckBox x:Name="checkBoxIISFiles"
									  Content="Files"
									  IsChecked="True" Margin="0,2"
									  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
						<CheckBox x:Name="checkBoxAspTmpFiles"
									  Content="Asp Temp Files"
									  IsChecked="True" Margin="0,2"
									  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
						<CheckBox x:Name="checkBoxSnapshots"
									  Content="Snapshot files"
									  IsChecked="True" Margin="0,2"
									  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
						<CheckBox x:Name="checkBoxCustomizations"
									  Content="Customization files"
									  IsChecked="True" Margin="0,2"
									  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
						<CheckBox x:Name="checkBoxBackups"
									  Content="Backup files"
									  IsChecked="True" Margin="0,2"
									  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
						<CheckBox x:Name="checkBoxDatabases"
									  Content="Databases"
									  IsChecked="True" Margin="0,2"
									  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
						<CheckBox x:Name="checkBoxRegistry"
									  Content="Registry"
									  IsChecked="True" Margin="0,2"
									  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
					</StackPanel>
				</GroupBox>

				<!-- Cleanup GroupBox -->
				<GroupBox x:Name="groupBoxCleanup" Grid.Row="1" Header="Cleanup" Margin="0,8,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
					<Grid Margin="4,2,4,4">
						<Grid.RowDefinitions>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<StackPanel Grid.Row="0">
							<CheckBox x:Name="checkBoxCleanupIISApps"         Content="Cleanup IIS apps"            IsChecked="True" Margin="0,2"/>
							<CheckBox x:Name="checkBoxCleanupFiles"           Content="Cleanup Files"               IsChecked="True" Margin="0,2"/>
							<CheckBox x:Name="checkBoxCleanupAspTemp"         Content="Cleanup Asp Temp files"      IsChecked="True" Margin="0,2"/>
							<CheckBox x:Name="checkBoxCleanupSnapshots"       Content="Cleanup Snapshot files"      IsChecked="True" Margin="0,2"/>
							<CheckBox x:Name="checkBoxCleanupCustomizations"  Content="Cleanup Customization files" IsChecked="True" Margin="0,2"/>
							<CheckBox x:Name="checkBoxCleanupBackups"         Content="Cleanup Backup files"        IsChecked="True" Margin="0,2"/>
							<CheckBox x:Name="checkBoxCleanupDatabases"       Content="Cleanup Databases"           IsChecked="True" Margin="0,2"/>
							<CheckBox x:Name="checkBoxCleanupRegistry"        Content="Cleanup Registry"            IsChecked="True" Margin="0,2"/>
						</StackPanel>
						<StackPanel Grid.Row="1"
										Orientation="Horizontal"
										HorizontalAlignment="Right"
										Margin="0,10,0,0">
							<Button x:Name="buttonClean"
										Content="Clean"
										Width="72" Height="23"
										Margin="0,0,6,0"
										Click="ButtonClean_Click" Background="#FF323232"/>
							<Button x:Name="buttonCleanAll"
										Content="Clean all"
										Width="72" Height="23"
										Click="ButtonCleanAll_Click" Background="#FF323232"/>
						</StackPanel>
					</Grid>
				</GroupBox>
			</Grid>

		</Grid>
	</DockPanel>
</UserControl>










