<UserControl x:Class="AcuCleanerVSExtension.AcuCleanerToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="White"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="White"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2D2D30"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBackgroundGradientKey}}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF808080"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF808080"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBackgroundGradientKey}}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>

        <!-- â”€â”€ Menu bar (File / Tools) â”€â”€ -->
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
              Foreground="White">
            <MenuItem Header="File" Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBackgroundGradientKey}}" Foreground="White">
                <MenuItem Header="Refresh"       InputGestureText="F5"      Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBackgroundGradientKey}}" Foreground="White" Click="RefreshMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Exit"          InputGestureText="Alt+F4"  Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBackgroundGradientKey}}" Foreground="White" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Tools" Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBackgroundGradientKey}}" Foreground="White">
                <MenuItem Header="Reset Password"          InputGestureText="Ctrl+P" Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBackgroundGradientKey}}" Foreground="White" Click="ResetPasswordMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Enable Modern UI Switch" InputGestureText="Ctrl+M" Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBackgroundGradientKey}}" Foreground="White" Click="EnableModernUISwitchMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Extend Session Timeout"  InputGestureText="Ctrl+T" Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBackgroundGradientKey}}" Foreground="White" Click="ExtendSessionTimeoutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!-- â”€â”€ Status bar â”€â”€ -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}">
            <StatusBarItem>
                <TextBlock x:Name="statusLabel" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="progressBar"
                             Width="100" Height="14"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>
            </StatusBarItem>
        </StatusBar>

        <!-- â”€â”€ Main content â”€â”€ -->
        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <!-- â”€â”€ Instances GroupBox + DataGrid â”€â”€ -->
            <GroupBox Grid.Column="0" Header="Instances" Margin="0,0,4,0">
                <DataGrid x:Name="dataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                          Foreground="White"
                          BorderBrush="#FF808080"
                          RowBackground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                          AlternatingRowBackground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                          HorizontalGridLinesBrush="#FF303030"
                          VerticalGridLinesBrush="#FF303030">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Active}" Value="False">
                                    <Setter Property="Foreground" Value="Orange"/>
                                    <Setter Property="ToolTip"    Value="Inactive â€” not currently running in IIS"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"                  Binding="{Binding Id}"               Width="45"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="Status"             Binding="{Binding Status}"           Width="70"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="Instance"           Binding="{Binding InstanceName}"     Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Installed On"       Binding="{Binding InstalledOn, StringFormat=\{0:d\}}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Database"           Binding="{Binding DatabaseName}"     Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Path"               Binding="{Binding Path}"             Width="160" IsReadOnly="True"/>
                        <DataGridTextColumn Header="AspTempFiles Path"  Binding="{Binding AspTempFilesPath}" Width="*"   IsReadOnly="True"/>
                        <DataGridTextColumn Header="Customization Path" Binding="{Binding CustomizationPath}" Width="*"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="Backup Path"        Binding="{Binding BackupPath}"       Width="*"   IsReadOnly="True"/>
                        <DataGridTextColumn Header="Snapshot Path"      Binding="{Binding SnapshotPath}"     Width="*"   IsReadOnly="True"/>
                        <DataGridTextColumn Header="Registry Path"      Binding="{Binding RegistryPath}"     Width="*"   IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- â”€â”€ Right panel: Filter + Cleanup â”€â”€ -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Filter GroupBox -->
                    <GroupBox Header="Filter">
                        <StackPanel Margin="4,2,4,4">
                            <TextBlock Text="Older than:" Margin="0,4,0,2"/>
                            <DatePicker x:Name="datePicker"
                                        Margin="0,0,0,6"
                                        SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                            <CheckBox x:Name="checkBoxActive"
                                      Content="Active"
                                      IsChecked="True" Margin="0,2"
                                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                            <CheckBox x:Name="checkBoxJunk"
                                      Content="Inactive"
                                      IsChecked="True" Margin="0,2"
                                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                            <CheckBox x:Name="checkBoxIISFiles"
                                      Content="Files"
                                      IsChecked="True" Margin="0,2"
                                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                            <CheckBox x:Name="checkBoxAspTmpFiles"
                                      Content="Asp Temp Files"
                                      IsChecked="True" Margin="0,2"
                                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                            <CheckBox x:Name="checkBoxSnapshots"
                                      Content="Snapshot files"
                                      IsChecked="True" Margin="0,2"
                                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                            <CheckBox x:Name="checkBoxCustomizations"
                                      Content="Customization files"
                                      IsChecked="True" Margin="0,2"
                                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                            <CheckBox x:Name="checkBoxBackups"
                                      Content="Backup files"
                                      IsChecked="True" Margin="0,2"
                                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                            <CheckBox x:Name="checkBoxDatabases"
                                      Content="Databases"
                                      IsChecked="True" Margin="0,2"
                                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                            <CheckBox x:Name="checkBoxRegistry"
                                      Content="Registry"
                                      IsChecked="True" Margin="0,2"
                                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Cleanup GroupBox -->
                    <GroupBox Header="Cleanup" Margin="0,8,0,0">
                        <StackPanel Margin="4,2,4,4">
                            <CheckBox x:Name="checkBoxCleanupIISApps"        Content="Cleanup IIS apps"            IsChecked="True" Margin="0,2"/>
                            <CheckBox x:Name="checkBoxCleanupFiles"           Content="Cleanup Files"               IsChecked="True" Margin="0,2"/>
                            <CheckBox x:Name="checkBoxCleanupAspTemp"         Content="Cleanup Asp Temp files"      IsChecked="True" Margin="0,2"/>
                            <CheckBox x:Name="checkBoxCleanupSnapshots"       Content="Cleanup Snapshot files"      IsChecked="True" Margin="0,2"/>
                            <CheckBox x:Name="checkBoxCleanupCustomizations"  Content="Cleanup Customization files" IsChecked="True" Margin="0,2"/>
                            <CheckBox x:Name="checkBoxCleanupBackups"         Content="Cleanup Backup files"        IsChecked="True" Margin="0,2"/>
                            <CheckBox x:Name="checkBoxCleanupDatabases"       Content="Cleanup Databases"           IsChecked="True" Margin="0,2"/>
                            <CheckBox x:Name="checkBoxCleanupRegistry"        Content="Cleanup Registry"            IsChecked="True" Margin="0,2"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,10,0,0">
                                <Button x:Name="buttonClean"
                                        Content="Clean"
                                        Width="72" Height="23"
                                        Margin="0,0,6,0"
                                        Click="ButtonClean_Click"/>
                                <Button x:Name="buttonCleanAll"
                                        Content="Clean all"
                                        Width="72" Height="23"
                                        Click="ButtonCleanAll_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </DockPanel>
</UserControl>










